# Copy to .env for local runs. In production, secrets come from files
# (X_FILE variables) mounted as Docker secrets; see docs/deploy-hostinger.md.

# Postgres connection. Production: DATABASE_URL_FILE=/run/secrets/database_url
DATABASE_URL=postgres://finbot:finbot@127.0.0.1:54320/finbot

# Bot token from @BotFather. Without it only the REST API runs.
# Production: TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token
TELEGRAM_BOT_TOKEN=

# Telegram user ids allowed to use the bot, comma separated.
ALLOWED_TELEGRAM_USER_IDS=

# Household timezone (IANA). Every accounting date uses it.
HOUSEHOLD_TIMEZONE=America/Sao_Paulo

# HTTP API bind address.
HTTP_BIND=127.0.0.1:8080

# Swagger UI at /docs. Keep false in production.
SWAGGER_ENABLED=true

# json (production) or pretty (development).
LOG_FORMAT=pretty
RUST_LOG=info,sqlx=warn
